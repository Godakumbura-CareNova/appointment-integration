<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="GCN-44 Appointment Booking (5 scenarios)" enabled="true"><stringProp name="TestPlan.comments">GCN-44 QA. LOCAL runs only. Exactly 5 scenarios JM-01..JM-05, run one after another. No secrets in this file: supply -JpatientToken at runtime. doctor-payment-service is only a runtime dependency.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><boolProp name="TestPlan.serialize_threadgroups">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="TestPlan.user_define_classpath"></stringProp></TestPlan><hashTree><Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables (runtime properties)" enabled="true"><collectionProp name="Arguments.arguments"><elementProp name="HOST" elementType="Argument"><stringProp name="Argument.name">HOST</stringProp><stringProp name="Argument.value">${__P(host,localhost)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="APPOINTMENT_PORT" elementType="Argument"><stringProp name="Argument.name">APPOINTMENT_PORT</stringProp><stringProp name="Argument.value">${__P(appointmentPort,5136)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="DOCTOR_ID" elementType="Argument"><stringProp name="Argument.name">DOCTOR_ID</stringProp><stringProp name="Argument.value">${__P(doctorId,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="PATIENT_TOKEN" elementType="Argument"><stringProp name="Argument.name">PATIENT_TOKEN</stringProp><stringProp name="Argument.value">${__P(patientToken,)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="SLOT_SUCCESS" elementType="Argument"><stringProp name="Argument.name">SLOT_SUCCESS</stringProp><stringProp name="Argument.value">${__P(slotSuccess,1)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="SLOT_DUPLICATE" elementType="Argument"><stringProp name="Argument.name">SLOT_DUPLICATE</stringProp><stringProp name="Argument.value">${__P(slotDuplicate,2)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="SLOT_CONCURRENT" elementType="Argument"><stringProp name="Argument.name">SLOT_CONCURRENT</stringProp><stringProp name="Argument.value">${__P(slotConcurrent,3)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></Arguments><hashTree></hashTree><ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults (local only)" enabled="true"><elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.domain">${HOST}</stringProp><stringProp name="HTTPSampler.port">${APPOINTMENT_PORT}</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp></ConfigTestElement><hashTree></hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Content-Type JSON" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></Header