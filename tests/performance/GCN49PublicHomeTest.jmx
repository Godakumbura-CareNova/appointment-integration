  if (body.introduction != "CareNova connects you with pharmacy services and healthcare professionals. Explore our medicines, discover doctors and register to access patient services.") problems &lt;&lt; 'introduction differs from the configured text'
  def services = body.services.collect { [it.title, it.description] }
  if (services != [["Pharmacy services", "Browse medicines, check availability and learn about prescription requirements."], ["Healthcare professionals", "Find doctors and explore their published professional information."], ["Patient services", "Create an account to access available prescription, order and consultation services."]]) problems &lt;&lt; ('services differ from the configuration: ' + services)
  def notices = body.notices.collect { [it.title, it.message] }
  if (notices != [["Prescription medicines", "A valid prescription is required for prescription-only medicines."]]) problems &lt;&lt; ('notices differ from the configuration: ' + notices)
  def meds = body.featuredMedicines.collect { [it.id, it.name, it.price as BigDecimal, it.prescriptionRequired] }
  def wantMeds = [].collect { [it[0], it[1], it[2] as BigDecimal, it[3]] }
  if (meds != wantMeds) problems &lt;&lt; ('featuredMedicines ' + meds + ' differ from ' + wantMeds)
  def docs = body.featuredDoctors.collect { [it.doctorId, it.fullName, it.specialization, it.consultationFee as BigDecimal] }
  def wantDocs = [].collect { [it[0], it[1], it[2], it[3] as BigDecimal] }
