  def notices = body.notices.collect { [it.title, it.message] }
  if (notices != [["Prescription medicines", "A valid prescription is required for prescription-only medicines."]]) problems &lt;&lt; ('notices differ from the configuration: ' + notices)
  def meds = body.featuredMedicines.collect { [it.id, it.name, it.price as BigDecimal, it.prescriptionRequired] }
  def wantMeds = [[1, "Vitamin C", 200, false], [2, "Amoxicillin", 450.5, true]].collect { [it[0], it[1], it[2] as BigDecimal, it[3]] }
  if (meds != wantMeds) problems &lt;&lt; ('featuredMedicines ' + meds + ' differ from ' + wantMeds)
  def docs = body.featuredDoctors.collect { [it.doctorId, it.fullName, it.specialization, it.consultationFee as BigDecimal] }
  def wantDocs = [["00000000-0000-0000-0000-000000000001", "Dr Silva", "Cardiologist", 4500]].collect { [it[0], it[1], it[2], it[3] as BigDecimal] }
  if (docs != wantDocs) problems &lt;&lt; ('featuredDoctors ' + docs + ' differ from ' + wantDocs)
