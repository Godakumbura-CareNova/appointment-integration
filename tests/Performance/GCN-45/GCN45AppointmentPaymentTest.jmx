            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Response content" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
def fails = []
def check = { String what, boolean ok -&gt; if (!ok) { fails &lt;&lt; what } }
check(&apos;method Cash&apos;, json.method == &apos;Cash&apos;)
check(&apos;status Pending&apos;, json.status == &apos;Pending&apos;)
check(&apos;amount 2700&apos;, new BigDecimal(String.valueOf(json.amount)).compareTo(new BigDecimal(&apos;2700&apos;)) == 0)
check(&apos;appointment id&apos;, String.valueOf(json.appointmentId) == props.get(&apos;fx.F1.id&apos;))
if (fails) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(fails.join(&apos;; &apos;)) }</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="No stack trace, exception text or internal names in the response" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def b = prev.getResponseDataAsString() ?: &apos;&apos;
def bad = [&apos;Exception&apos;, &apos;StackTrace&apos;, &apos;Stack trace&apos;, &apos; at AppointmentIntegration&apos;, &apos;Microsoft.EntityFramework&apos;, &apos;MySql&apos;, &apos;Pomelo&apos;, &apos;System.&apos;]
def hit = bad.find { b.contains(it) }
if (hit != null) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&apos;response leaks internal detail: &apos; + hit) }</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
