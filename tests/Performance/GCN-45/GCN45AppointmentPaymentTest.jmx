            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Payment content" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
def fails = []
def check = { String what, boolean ok -&gt; if (!ok) { fails &lt;&lt; what } }
check(&apos;appointmentId is F1&apos;, String.valueOf(json.appointmentId) == props.get(&apos;fx.F1.id&apos;))
check(&apos;reference&apos;, json.appointmentReference != null &amp;&amp; json.appointmentReference.startsWith(&apos;CN-APT-&apos;))
check(&apos;method Cash&apos;, json.method == &apos;Cash&apos;)
check(&apos;status Pending&apos;, json.status == &apos;Pending&apos;)
check(&apos;amount 2700&apos;, new BigDecimal(String.valueOf(json.amount)).compareTo(new BigDecimal(&apos;2700&apos;)) == 0)
if (fails) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(fails.join(&apos;; &apos;)) }</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223Assertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="No single response slower than 3000 ms" enabled="true">
              <stringProp name="DurationAssertion.duration">3000</stringProp>
            </DurationAssertion>
            <hashTree/>
          </hashTree>
