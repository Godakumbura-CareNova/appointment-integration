    },
    "T02": {
      "name": "Admin payment summary and income",
      "method": "GET",
      "path": "/api/admin/dashboard/appointment-payments",
      "role": "Admin",
      "expected_status": 200,
      "requests": 1,
      "threshold_ms": 3000
    },
    "T03": {
      "name": "Admin appointment listing and pagination",
      "method": "GET",
      "path": "/api/admin/appointments?page=2&pageSize=5",
      "role": "Admin",
      "expected_status": 200,
      "requests": 1,
      "threshold_ms": 3000
    },
    "T04": {
      "name": "Admin income report and date grouping",
      "method": "GET",
      "path": "/api/admin/reports/appointment-income?from&to (21 days)",
