import groovy.json.JsonSlurper
def REQUIRED = ['id', 'appointmentReference', 'doctorName', 'appointmentStartUtc', 'appointmentEndUtc', 'status', 'section', 'paymentMethod', 'paymentStatus', 'canPay']
def sameInstant = { x, y -&gt; try { java.time.Instant.parse(String.valueOf(x)) == java.time.Instant.parse(String.valueOf(y)) } catch (Exception ex) { false } }
def verifyItem = { Map got, Map e, List fails -&gt;
  def p = 'appointment ' + e.id + ': '
  REQUIRED.each { k -&gt; if (!got.containsKey(k)) { fails &lt;&lt; (p + 'missing field ' + k) } }
  if (got.id != e.id) { fails &lt;&lt; (p + 'id ' + got.id) }
  if (got.appointmentReference != e.reference) { fails &lt;&lt; (p + 'reference ' + got.appointmentReference) }
  if (got.doctorName != e.doctorName) { fails &lt;&lt; (p + 'doctor ' + got.doctorName) }
  if (!sameInstant(got.appointmentStartUtc, e.startUtc) || !String.valueOf(got.appointmentStartUtc).endsWith('Z')) { fails &lt;&lt; (p + 'start ' + got.appointmentStartUtc) }
  if (!sameInstant(got.appointmentEndUtc, e.endUtc) || !String.valueOf(got.appointmentEndUtc).endsWith('Z')) { fails &lt;&lt; (p + 'end ' + got.appointmentEndUtc) }
  if (got.status != e.status) { fails &lt;&lt; (p + 'status ' + got.status + ' expected ' + e.status) }
  if (got.section != e.section) { fails &lt;&lt; (p + 'section ' + got.section + ' expected ' + e.section) }
  if (got.paymentMethod != e.paymentMethod) { fails &lt;&lt; (p + 'paymentMethod ' + got.paymentMethod + ' expected ' + e.paymentMethod) }
  if (got.paymentStatus != e.paymentStatus) { fails &lt;&lt; (p + 'paymentStatus ' + got.paymentStatus + ' expected ' + e.paymentStatus) }
  if (got.canPay != e.canPay) { fails &lt;&lt; (p + 'canPay ' + got.canPay + ' expected ' + e.canPay) }
}
def verifyList = { List got, String key, List fails, boolean full -&gt;
  def exp = props.get('fx')[key].appointments
  if (got.size() != exp.size()) { fails &lt;&lt; ('count ' + got.size() + ' expected ' + exp.size()) }
  def byId = [:]; exp.each { x -&gt; byId[x.id] = x }
  def seen = new HashSet(); def prefix = 'CN-APT-' + key + '-'
  int checked = 0
  got.each { g -&gt;
    if (!seen.add(g.id)) { fails &lt;&lt; ('duplicate id ' + g.id) }
    def e = byId[g.id]
    if (e == null) { fails &lt;&lt; ('foreign or unknown id ' + g.id) } else if (full || (checked++ &lt; 3)) { verifyItem(g, e, fails) }
    if (!String.valueOf(g.appointmentReference).startsWith(prefix)) { fails &lt;&lt; ('reference of another patient: ' + g.appointmentReference) }
  }
  if (!full &amp;&amp; seen.size() != exp.size()) { fails &lt;&lt; 'id set differs from the expected set' }
}
def finish = { List fails -&gt; if (fails) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(fails.take(4).join('; ')) } }
def fails = []
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
def kind = vars.get('KIND')
if (kind == 'ITEM') { def e = props.get('fx')[vars.get('PK')].appointments[Integer.parseInt(vars.get('IDX'))]
  if (!(json instanceof Map)) { fails &lt;&lt; 'response is not a JSON object' } else { verifyItem(json, e, fails) } }
else if (!(json instanceof List)) { fails &lt;&lt; 'response is not a JSON array' }
else if (kind == 'BIG') { verifyList(json, 'BIG', fails, false) }
else { verifyList(json, vars.get('PK'), fails, true) }
finish(fails)</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223Assertion><hashTree></hashTree><DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="No single response slower than 5000 ms (hard cap)" enabled="true"><stringProp name="DurationAssertion.duration">5000</stringProp></DurationAssertion><hashTree></hashTree><UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think time 200-300 ms" enabled="true"><stringProp name="ConstantTimer.delay">200</stringProp><stringProp name="RandomTimer.range">100</stringProp></UniformRandomTimer><hashTree></hashTree></hashTree></hashTree></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="JM-07d recovery" enabled="true"><stringProp name="TestPlan.comments">5 users for 45 s, think time 200-300 ms, mix: 10% large-history list (200 appointments), 40% own list, 50% own details. Read-only.</stringProp><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">-1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">5</stringProp><stringProp name="ThreadGroup.ramp_time">2</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">45</stringProp><stringProp name="ThreadGroup.delay"></stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></ThreadGroup><hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="Run only in phase load" enabled="true"><stringProp name="IfController.condition">${__groovy(props.get('phase') == 'load')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="JM-07d recovery" enabled="true"><stringProp name="HTTPSampler.domain">localhost</stringProp><stringProp name="HTTPSampler.port">5246</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">${PATH}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><stringProp name="HTTPSampler.connect_timeout">5000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Authorization" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">${__P(tok.${AUTHKEY},MISSING)}</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Choose request" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">
