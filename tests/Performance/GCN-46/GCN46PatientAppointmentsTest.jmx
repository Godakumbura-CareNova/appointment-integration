import groovy.json.JsonSlurper
def REQUIRED = ['id', 'appointmentReference', 'doctorName', 'appointmentStartUtc', 'appointmentEndUtc', 'status', 'section', 'paymentMethod', 'paymentStatus', 'canPay']
def sameInstant = { x, y -&gt; try { java.time.Instant.parse(String.valueOf(x)) == java.time.Instant.parse(String.valueOf(y)) } catch (Exception ex) { false } }
def verifyItem = { Map got, Map e, List fails -&gt;
  def p = 'appointment ' + e.id + ': '
  REQUIRED.each { k -&gt; if (!got.containsKey(k)) { fails &lt;&lt; (p + 'missing field ' + k) } }
  if (got.id != e.id) { fails &lt;&lt; (p + 'id ' + got.id) }
  if (got.appointmentReference != e.reference) { fails &lt;&lt; (p + 'reference ' + got.appointmentReference) }
  if (got.doctorName != e.doctorName) { fails &lt;&lt; (p + 'doctor ' + got.doctorName) }
  if (!sameInstant(got.appointmentStartUtc, e.startUtc) || !String.valueOf(got.appointmentStartUtc).endsWith('Z')) { fails &lt;&lt; (p + 'start ' + got.appointmentStartUtc) }
  if (!sameInstant(got.appointmentEndUtc, e.endUtc) || !String.valueOf(got.appointmentEndUtc).endsWith('Z')) { fails &lt;&lt; (p + 'end ' + got.appointmentEndUtc) }
  if (got.status != e.status) { fails &lt;&lt; (p + 'status ' + got.status + ' expected ' + e.status) }
  if (got.section != e.section) { fails &lt;&lt; (p + 'section ' + got.section + ' expected ' + e.section) }
  if (got.paymentMethod != e.paymentMethod) { fails &lt;&lt; (p + 'paymentMethod ' + got.paymentMethod + ' expected ' + e.paymentMethod) }
  if (got.paymentStatus != e.paymentStatus) { fails &lt;&lt; (p + 'paymentStatus ' + got.paymentStatus + ' expected ' + e.paymentStatus) }
  if (got.canPay != e.canPay) { fails &lt;&lt; (p + 'canPay ' + got.canPay + ' expected ' + e.canPay) }
}
def verifyList = { List got, String key, List fails, boolean full -&gt;
  def exp = props.get('fx')[key].appointments
  if (got.size() != exp.size()) { fails &lt;&lt; ('count ' + got.size() + ' expected ' + exp.size()) }
  def byId = [:]; exp.each { x -&gt; byId[x.id] = x }
  def seen = new HashSet(); def prefix = 'CN-APT-' + key + '-'
  int checked = 0
  got.each { g -&gt;
    if (!seen.add(g.id)) { fails &lt;&lt; ('duplicate id ' + g.id) }
    def e = byId[g.id]
    if (e == null) { fails &lt;&lt; ('foreign or unknown id ' + g.id) } else if (full || (checked++ &lt; 3)) { verifyItem(g, e, fails) }
    if (!String.valueOf(g.appointmentReference).startsWith(prefix)) { fails &lt;&lt; ('reference of another patient: ' + g.appointmentReference) }
  }
  if (!full &amp;&amp; seen.size() != exp.size()) { fails &lt;&lt; 'id set differs from the expected set' }
}
def finish = { List fails -&gt; if (fails) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(fails.take(4).join('; ')) } }
def fails = []
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
if (!(json instanceof List)) { fails &lt;&lt; 'response is not a JSON array' } else { verifyList(json, vars.get('PK'), fails, true) }
finish(fails)</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223Assertion><hashTree></hashTree><DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="No single response slower than 1500 ms (hard cap)" enabled="true"><stringProp name="DurationAssertion.duration">1500</stringProp></DurationAssertion><hashTree></hashTree><SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="Release all 25 users together" enabled="true"><intProp name="groupSize">25</intProp><longProp name="timeoutInMs">20000</longProp></SyncTimer><hashTree></hashTree></hashTree></hashTree></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="JM-04 Data integrity and categorization under load" enabled="true"><stringProp name="TestPlan.comments">Edge-case patient S (14 appointments covering every backend rule) read by 5 users x 10 loops: 1 list + 14 details each. Read-only. Order is NOT asserted (no ORDER BY in the backend); it is only observed.</stringProp><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">10</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">5</stringProp><stringProp name="ThreadGroup.ramp_time">2</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></ThreadGroup><hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="Run only in phase functional" enabled="true"><stringProp name="IfController.condition">${__groovy(props.get('phase') == 'functional')}</stringProp>