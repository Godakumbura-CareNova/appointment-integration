<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="GCN-46 Patient Appointments API (7 scenarios JM-01..JM-07)" enabled="true"><stringProp name="TestPlan.comments">GCN-46 QA. LOCAL only: backend localhost:5246, isolated database carenova_appointment_gcn46_qa, synthetic patients. Read-only GET requests. Run per phase with -Jphase=functional (JM-01..JM-06) or -Jphase=load (JM-07). Thresholds are provisional QA targets, not product requirements. No secrets in this file.</stringProp><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp><boolProp name="TestPlan.serialize_threadgroups">true</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="TestPlan.user_define_classpath"></stringProp></TestPlan><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Accept" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report" enabled="true"><boolProp name="ResultCollector.error_logging">false</boolProp><objProp><name>saveConfig</name><value class="SampleSaveConfiguration"><time>true</time><latency>true</latency><timestamp>true</timestamp><success>true</success><label>true</label><code>true</code><message>true</message><threadName>true</threadName><dataType>true</dataType><encoding>false</encoding><assertions>true</assertions><subresults>true</subresults><responseData>false</responseData><samplerData>false</samplerData><xml>false</xml><fieldNames>true</fieldNames><responseHeaders>false</responseHeaders><requestHeaders>false</requestHeaders><responseDataOnError>false</responseDataOnError><saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage><assertionsResultsToSave>0</assertionsResultsToSave><bytes>true</bytes><sentBytes>true</sentBytes><url>true</url><threadCounts>true</threadCounts><idleTime>true</idleTime><connectTime>true</connectTime></value></objProp><stringProp name="filename"></stringProp></ResultCollector><hashTree></hashTree><ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree" enabled="true"><boolProp name="ResultCollector.error_logging">false</boolProp><objProp><name>saveConfig</name><value class="SampleSaveConfiguration"><time>true</time><latency>true</latency><timestamp>true</timestamp><success>true</success><label>true</label><code>true</code><message>true</message><threadName>true</threadName><dataType>true</dataType><encoding>false</encoding><assertions>true</assertions><subresults>true</subresults><responseData>false</responseData><samplerData>false</samplerData><xml>false</xml><fieldNames>true</fieldNames><responseHeaders>false</responseHeaders><requestHeaders>false</requestHeaders><responseDataOnError>false</responseDataOnError><saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage><assertionsResultsToSave>0</assertionsResultsToSave><bytes>true</bytes><sentBytes>true</sentBytes><url>true</url><threadCounts>true</threadCounts><idleTime>true</idleTime><connectTime>true</connectTime></value></objProp><stringProp name="filename"></stringProp></ResultCollector><hashTree></hashTree><SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="SETUP environment check, fixtures and synthetic tokens" enabled="true"><stringProp name="TestPlan.comments">Checks the local backend on 5246 (401 without a token), loads the synthetic fixtures (and refuses stale ones), mints test tokens from the secret in the process environment. Stops the run if anything is wrong.</stringProp><stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></SetupThreadGroup><hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SETUP environment check, fixtures and synthetic tokens" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">
import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec
def b64u = { byte[] b -&gt; java.util.Base64.getUrlEncoder().withoutPadding().encodeToString(b) }
def mint = { String secret, String role, String sub, long expOffset, String iss, String aud, String alg -&gt;
  def header = b64u(('{"alg":"' + alg + '","typ":"JWT"}').getBytes('UTF-8'))
  long exp = (long) (System.currentTimeMillis() / 1000L) + expOffset
  def nameId = 'http://schemas.microsoft.com/ws/2008/06/identity/claims/nameidentifier'
  def roleId = 'http://schemas.microsoft.com/ws/2008/06/identity/claims/role'
  def payload = b64u(('{"sub":"' + sub + '","' + nameId + '":"' + sub + '","' + roleId + '":"' + role + '","iss":"' + iss + '","aud":"' + aud + '","exp":' + exp + '}').getBytes('UTF-8'))
  if (alg == 'none') { return header + '.' + payload + '.' }
  def mac = Mac.getInstance('HmacSHA256'); mac.init(new SecretKeySpec(secret.getBytes('UTF-8'), 'HmacSHA256'))
  header + '.' + payload + '.' + b64u(mac.doFinal((header + '.' + payload).getBytes('UTF-8')))
}

import groovy.json.JsonSlurper
def phase = props.get('phase')
if (!['functional', 'load'].contains(phase)) { throw new IllegalStateException('property phase must be functional or load') }
def jwt = System.getenv('GCN46_JWT_SECRET')
if (!jwt) { throw new IllegalStateException('GCN46_JWT_SECRET is not in the environment of the JMeter process') }
def code = { String url -&gt; try { def c = new URL(url).openConnection(); c.requestMethod = 'GET'; c.connectTimeout = 3000; c.readTimeout = 8000; c.responseCode } catch (Exception ex) { -1 } }
if (code('http://localhost:5246/api/appointments') != 401) { throw new IllegalStateException('backend on 5246 is not running with authentication on (expected 401 without a token)') }
def f = new File(props.get('fixturesFile') ?: '')
if (!f.exists()) { throw new IllegalStateException('fixtures file missing: generate and seed the synthetic data first') }
def fx = new JsonSlurper().parseText(f.text)
if (java.time.Instant.now().isAfter(java.time.Instant.parse(fx.validUntilUtc))) { throw new IllegalStateException('fixtures are older than 36 hours: upcoming/previous expectations may have drifted; regenerate and re-seed') }
if (fx.synthetic != true) { throw new IllegalStateException('fixtures are not marked synthetic') }
// JsonSlurper returns LAZY maps that are NOT thread-safe: concurrent first reads from several threads can return null (found in run 1, JM-06).
// Materialize everything once, here (single thread), into plain maps and lists that the scenarios only read.
def deep; deep = { x -&gt; x instanceof Map ? x.collectEntries { k, v -&gt; [(k): deep(v)] } : (x instanceof List ? x.collect { deep(it) } : x) }
def patients = deep(fx.patients)
props.put('fx', patients)
props.put('fx.L01.first', String.valueOf(patients['L01'].appointments[0].id))
props.put('jm04.orders', java.util.concurrent.ConcurrentHashMap.newKeySet())
def iss = 'CareNova.UserAuth'; def aud = 'CareNova.Client'
fx.patients.each { k, v -&gt; props.put('tok.' + k, 'Bearer ' + mint(jwt, 'Patient', v.id, 3600L, iss, aud, 'HS256')) }
def l01 = fx.patients['L01'].id
props.put('tok.L01USER', 'Bearer ' + mint(jwt, 'User', l01, 3600L, iss, aud, 'HS256'))
props.put('tok.EXPIRED', 'Bearer ' + mint(jwt, 'Patient', l01, -3600L, iss, aud, 'HS256'))
props.put('tok.WRONGSECRET', 'Bearer ' + mint('this-is-not-the-signing-secret-0123456789', 'Patient', l01, 3600L, iss, aud, 'HS256'))
props.put('tok.WRONGISSUER', 'Bearer ' + mint(jwt, 'Patient', l01, 3600L, 'Other.Issuer', aud, 'HS256'))
props.put('tok.WRONGAUDIENCE', 'Bearer ' + mint(jwt, 'Patient', l01, 3600L, iss, 'Other.Audience', 'HS256'))
props.put('tok.ALGNONE', 'Bearer ' + mint(jwt, 'Patient', l01, 3600L, iss, aud, 'none'))
props.put('tok.BADSUB', 'Bearer ' + mint(jwt, 'Patient', 'not-a-guid', 3600L, iss, aud, 'HS256'))
props.put('tok.EMPTYSUB', 'Bearer ' + mint(jwt, 'Patient', '00000000-0000-0000-0000-000000000000', 3600L, iss, aud, 'HS256'))
props.put('tok.DOCTOR', 'Bearer ' + mint(jwt, 'Doctor', '46e00000-0000-4000-8000-000000000001', 3600L, iss, aud, 'HS256'))
props.put('tok.ADMIN', 'Bearer ' + mint(jwt, 'Admin', '46e00000-0000-4000-8000-000000000002', 3600L, iss, aud, 'HS256'))
props.put('tok.STAFF', 'Bearer ' + mint(jwt, 'PharmacyStaff', '46e00000-0000-4000-8000-000000000003', 3600L, iss, aud, 'HS256'))
props.put('tok.GARBAGE', 'Bearer not-a-jwt')
props.put('tok.BASIC', 'Basic dGVzdDp0ZXN0')
props.put('tok.EMPTY', 'Bearer ')
SampleResult.setResponseData('phase=' + phase + ' patients=' + fx.patients.size() + ' fixtures generated ' + fx.generatedAtUtc, 'UTF-8')
SampleResult.setSuccessful(true)
</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223Sampler><hashTree></hashTree></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="JM-01 Patient appointment list under normal load" enabled="true"><stringProp name="TestPlan.comments">10 users x 30 loops, each user a different synthetic patient (12 appointments each). Read-only.</stringProp><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">30</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">10</stringProp><stringProp name="ThreadGroup.ramp_time">5</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></ThreadGroup><hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="Run only in phase functional" enabled="true"><stringProp name="IfController.condition">${__groovy(props.get('phase') == 'functional')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="JM-01 GET /api/appointments (own list)" enabled="true"><stringProp name="HTTPSampler.domain">localhost</stringProp><stringProp name="HTTPSampler.port">5246</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/appointments</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><stringProp name="HTTPSampler.connect_timeout">5000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Authorization" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">${__P(tok.${PK},MISSING)}</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Choose patient and appointment" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">def n = ctx.getThreadNum()
vars.put('PK', 'L' + String.format('%02d', n + 1))
</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PreProcessor><hashTree></hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status is 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">200</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree></hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Content-Type is JSON" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">application/json</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_headers</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">16</intProp></ResponseAssertion><hashTree></hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="The list is exactly this patient's 12 appointments with the seeded values" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">
import groovy.json.JsonSlurper
def REQUIRED = ['id', 'appointmentReference', 'doctorName', 'appointmentStartUtc', 'appointmentEndUtc', 'status', 'section', 'paymentMethod', 'paymentStatus', 'canPay']
def sameInstant = { x, y -&gt; try { java.time.Instant.parse(String.valueOf(x)) == java.time.Instant.parse(String.valueOf(y)) } catch (Exception ex) { false } }
def verifyItem = { Map got, Map e, List fails -&gt;
  def p = 'appointment ' + e.id + ': '
  REQUIRED.each { k -&gt; if (!got.containsKey(k)) { fails &lt;&lt; (p + 'missing field ' + k) } }
  if (got.id != e.id) { fails &lt;&lt; (p + 'id ' + got.id) }
  if (got.appointmentReference != e.reference) { fails &lt;&lt; (p + 'reference ' + got.appointmentReference) }
  if (got.doctorName != e.doctorName) { fails &lt;&lt; (p + 'doctor ' + got.doctorName) }
  if (!sameInstant(got.appointmentStartUtc, e.startUtc) || !String.valueOf(got.appointmentStartUtc).endsWith('Z')) { fails &lt;&lt; (p + 'start ' + got.appointmentStartUtc) }
  if (!sameInstant(got.appointmentEndUtc, e.endUtc) || !String.valueOf(got.appointmentEndUtc).endsWith('Z')) { fails &lt;&lt; (p + 'end ' + got.appointmentEndUtc) }
  if (got.status != e.status) { fails &lt;&lt; (p + 'status ' + got.status + ' expected ' + e.status) }
  if (got.section != e.section) { fails &lt;&lt; (p + 'section ' + got.section + ' expected ' + e.section) }
  if (got.paymentMethod != e.paymentMethod) { fails &lt;&lt; (p + 'paymentMethod ' + got.paymentMethod + ' expected ' + e.paymentMethod) }
  if (got.paymentStatus != e.paymentStatus) { fails &lt;&lt; (p + 'paymentStatus ' + got.paymentStatus + ' expected ' + e.paymentStatus) }
  if (got.canPay != e.canPay) { fails &lt;&lt; (p + 'canPay ' + got.canPay + ' expected ' + e.canPay) }
}
def verifyList = { List got, String key, List fails, boolean full -&gt;
  def exp = props.get('fx')[key].appointments
  if (got.size() != exp.size()) { fails &lt;&lt; ('count ' + got.size() + ' expected ' + exp.size()) }
  def byId = [:]; exp.each { x -&gt; byId[x.id] = x }
  def seen = new HashSet(); def prefix = 'CN-APT-' + key + '-'
  int checked = 0
  got.each { g -&gt;
    if (!seen.add(g.id)) { fails &lt;&lt; ('duplicate id ' + g.id) }
    def e = byId[g.id]
    if (e == null) { fails &lt;&lt; ('foreign or unknown id ' + g.id) } else if (full || (checked++ &lt; 3)) { verifyItem(g, e, fails) }
    if (!String.valueOf(g.appointmentReference).startsWith(prefix)) { fails &lt;&lt; ('reference of another patient: ' + g.appointmentReference) }
  }
  if (!full &amp;&amp; seen.size() != exp.size()) { fails &lt;&lt; 'id set differs from the expected set' }
}
def finish = { List fails -&gt; if (fails) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(fails.take(4).join('; ')) } }
def fails = []
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
if (!(json instanceof List)) { fails &lt;&lt; 'response is not a JSON array' } else { verifyList(json, vars.get('PK'), fails, true) }
finish(fails)</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223Assertion><hashTree></hashTree><DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="No single response slower than 1500 ms (hard cap)" enabled="true"><stringProp name="DurationAssertion.duration">1500</stringProp></DurationAssertion><hashTree></hashTree><UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="Think time 250-350 ms" enabled="true"><stringProp name="ConstantTimer.delay">250</stringProp><stringProp name="RandomTimer.range">100</stringProp></UniformRandomTimer><hashTree></hashTree></hashTree></hashTree></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="JM-02 Patient appointment details under normal load" enabled="true"><stringProp name="TestPlan.comments">10 users x 30 loops, rotating over the patient's own 12 appointment ids. Read-only.</stringProp><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">30</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">10</stringProp><stringProp name="ThreadGroup.ramp_time">5</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></ThreadGroup><hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="Run only in phase functional" enabled="true"><stringProp name="IfController.condition">${__groovy(props.get('phase') == 'functional')}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="JM-02 GET /api/appointments/{id} (own appointment)" enabled="true"><stringProp name="HTTPSampler.domain">localhost</stringProp><stringProp name="HTTPSampler.port">5246</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/appointments/${AID}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><stringProp name="HTTPSampler.connect_timeout">5000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Authorization" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">${__P(tok.${PK},MISSING)}</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Choose patient and appointment" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">def n = ctx.getThreadNum()
vars.put('PK', 'L' + String.format('%02d', n + 1))
int idx = (vars.getIteration() + n) % 12
vars.put('IDX', String.valueOf(idx))
vars.put('AID', String.valueOf(props.get('fx')[vars.get('PK')].appointments[idx].id))</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PreProcessor><hashTree></hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status is 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">200</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree></hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Content-Type is JSON" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">application/json</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_headers</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">16</intProp></ResponseAssertion><hashTree></hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="The appointment equals the seeded record" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">
import groovy.json.JsonSlurper
def REQUIRED = ['id', 'appointmentReference', 'doctorName', 'appointmentStartUtc', 'appointmentEndUtc', 'status', 'section', 'paymentMethod', 'paymentStatus', 'canPay']
def sameInstant = { x, y -&gt; try { java.time.Instant.parse(String.valueOf(x)) == java.time.Instant.parse(String.valueOf(y)) } catch (Exception ex) { false } }
def verifyItem = { Map got, Map e, List fails -&gt;
  def p = 'appointment ' + e.id + ': '
  REQUIRED.each { k -&gt; if (!got.containsKey(k)) { fails &lt;&lt; (p + 'missing field ' + k) } }
  if (got.id != e.id) { fails &lt;&lt; (p + 'id ' + got.id) }
  if (got.appointmentReference != e.reference) { fails &lt;&lt; (p + 'reference ' + got.appointmentReference) }
  if (got.doctorName != e.doctorName) { fails &lt;&lt; (p + 'doctor ' + got.doctorName) }
  if (!sameInstant(got.appointmentStartUtc, e.startUtc) || !String.valueOf(got.appointmentStartUtc).endsWith('Z')) { fails &lt;&lt; (p + 'start ' + got.appointmentStartUtc) }
  if (!sameInstant(got.appointmentEndUtc, e.endUtc) || !String.valueOf(got.appointmentEndUtc).endsWith('Z')) { fails &lt;&lt; (p + 'end ' + got.appointmentEndUtc) }
  if (got.status != e.status) { fails &lt;&lt; (p + 'status ' + got.status + ' expected ' + e.status) }
  if (got.section != e.section) { fails &lt;&lt; (p + 'section ' + got.section + ' expected ' + e.section) }
  if (got.paymentMethod != e.paymentMethod) { fails &lt;&lt; (p + 'paymentMethod ' + got.paymentMethod + ' expected ' + e.paymentMethod) }
  if (got.paymentStatus != e.paymentStatus) { fails &lt;&lt; (p + 'paymentStatus ' + got.paymentStatus + ' expected ' + e.paymentStatus) }
  if (got.canPay != e.canPay) { fails &lt;&lt; (p + 'canPay ' + got.canPay + ' expected ' + e.canPay) }
}
def verifyList = { List got, String key, List fails, boolean full -&gt;
  def exp = props.get('fx')[key].appointments
  if (got.size() != exp.size()) { fails &lt;&lt; ('count ' + got.size() + ' expected ' + exp.size()) }
  def byId = [:]; exp.each { x -&gt; byId[x.id] = x }
  def seen = new HashSet(); def prefix = 'CN-APT-' + key + '-'
  int checked = 0
  got.each { g -&gt;
    if (!seen.add(g.id)) { fails &lt;&lt; ('duplicate id ' + g.id) }
    def e = byId[g.id]
    if (e == null) { fails &lt;&lt; ('foreign or unknown id ' + g.id) } else if (full || (checked++ &lt; 3)) { verifyItem(g, e, fails) }
    if (!String.valueOf(g.appointmentReference).startsWith(prefix)) { fails &lt;&lt; ('reference of another patient: ' + g.appointmentReference) }
  }
  if (!full &amp;&amp; seen.size() != exp.size()) { fails &lt;&lt; 'id set differs from the expected set' }
}
def finish = { List fails -&gt; if (fails) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(fails.take(4).join('; ')) } }
def fails = []
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
