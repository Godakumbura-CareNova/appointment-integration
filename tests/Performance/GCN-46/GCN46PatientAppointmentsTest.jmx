import groovy.json.JsonSlurper
def REQUIRED = ['id', 'appointmentReference', 'doctorName', 'appointmentStartUtc', 'appointmentEndUtc', 'status', 'section', 'paymentMethod', 'paymentStatus', 'canPay']
def sameInstant = { x, y -&gt; try { java.time.Instant.parse(String.valueOf(x)) == java.time.Instant.parse(String.valueOf(y)) } catch (Exception ex) { false } }
def verifyItem = { Map got, Map e, List fails -&gt;
  def p = 'appointment ' + e.id + ': '
  REQUIRED.each { k -&gt; if (!got.containsKey(k)) { fails &lt;&lt; (p + 'missing field ' + k) } }
  if (got.id != e.id) { fails &lt;&lt; (p + 'id ' + got.id) }
  if (got.appointmentReference != e.reference) { fails &lt;&lt; (p + 'reference ' + got.appointmentReference) }
  if (got.doctorName != e.doctorName) { fails &lt;&lt; (p + 'doctor ' + got.doctorName) }
  if (!sameInstant(got.appointmentStartUtc, e.startUtc) || !String.valueOf(got.appointmentStartUtc).endsWith('Z')) { fails &lt;&lt; (p + 'start ' + got.appointmentStartUtc) }
  if (!sameInstant(got.appointmentEndUtc, e.endUtc) || !String.valueOf(got.appointmentEndUtc).endsWith('Z')) { fails &lt;&lt; (p + 'end ' + got.appointmentEndUtc) }
  if (got.status != e.status) { fails &lt;&lt; (p + 'status ' + got.status + ' expected ' + e.status) }
  if (got.section != e.section) { fails &lt;&lt; (p + 'section ' + got.section + ' expected ' + e.section) }
  if (got.paymentMethod != e.paymentMethod) { fails &lt;&lt; (p + 'paymentMethod ' + got.paymentMethod + ' expected ' + e.paymentMethod) }
  if (got.paymentStatus != e.paymentStatus) { fails &lt;&lt; (p + 'paymentStatus ' + got.paymentStatus + ' expected ' + e.paymentStatus) }
  if (got.canPay != e.canPay) { fails &lt;&lt; (p + 'canPay ' + got.canPay + ' expected ' + e.canPay) }
}
def verifyList = { List got, String key, List fails, boolean full -&gt;
  def exp = props.get('fx')[key].appointments
  if (got.size() != exp.size()) { fails &lt;&lt; ('count ' + got.size() + ' expected ' + exp.size()) }
  def byId = [:]; exp.each { x -&gt; byId[x.id] = x }
  def seen = new HashSet(); def prefix = 'CN-APT-' + key + '-'
  int checked = 0
  got.each { g -&gt;
    if (!seen.add(g.id)) { fails &lt;&lt; ('duplicate id ' + g.id) }
    def e = byId[g.id]
    if (e == null) { fails &lt;&lt; ('foreign or unknown id ' + g.id) } else if (full || (checked++ &lt; 3)) { verifyItem(g, e, fails) }
    if (!String.valueOf(g.appointmentReference).startsWith(prefix)) { fails &lt;&lt; ('reference of another patient: ' + g.appointmentReference) }
  }
  if (!full &amp;&amp; seen.size() != exp.size()) { fails &lt;&lt; 'id set differs from the expected set' }
}
def finish = { List fails -&gt; if (fails) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(fails.take(4).join('; ')) } }
def fails = []
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
if (!(json instanceof List)) { fails &lt;&lt; 'response is not a JSON array' } else { verifyList(json, vars.get('PK'), fails, true) }
finish(fails)</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223Assertion><hashTree></hashTree><DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="No single response slower than 1500 ms (hard cap)" enabled="true"><stringProp name="DurationAssertion.duration">1500</stringProp></DurationAssertion><hashTree></hashTree></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="JM-05 list control: legacy User role -&gt; 200" enabled="true"><stringProp name="HTTPSampler.domain">localhost</stringProp><stringProp name="HTTPSampler.port">5246</stringProp><stringProp name="HTTPSampler.protocol">http</stringProp><stringProp name="HTTPSampler.path">/api/appointments</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.auto_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.DO_MULTIPART_POST">false</boolProp><stringProp name="HTTPSampler.connect_timeout">5000</stringProp><stringProp name="HTTPSampler.response_timeout">30000</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Authorization" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">${__P(tok.L01USER,MISSING)}</stringProp></elementProp></collectionProp></HeaderManager><hashTree></hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Patient L01" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">vars.put('PK', 'L01')</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PreProcessor><hashTree></hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Status is 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">200</stringProp></collectionProp><stringProp name="Assertion.custom_message"></stringProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree></hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Control returns exactly L01's data" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">
